{
  "name": "lexavataaars",
  "version": "0.2.0",
  "type": "module",
  "description": "Deterministic avatars for legal software \u2014 judges, prosecutors, notaries and advocates, in business formal and court dress. A DiceBear-compatible style.",
  "keywords": [
    "avatar",
    "dicebear",
    "legal",
    "legaltech",
    "svg",
    "identicon",
    "avataaars"
  ],
  "license": "MIT",
  "author": "Patrik Szewczyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePatriczek/lexavataaars.git"
  },
  "homepage": "https://github.com/ThePatriczek/lexavataaars#readme",
  "bugs": {
    "url": "https://github.com/ThePatriczek/lexavataaars/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definition.json": "./dist/lexavataaars.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types && bun run build:json && bun run build:docs",
    "build:js": "bun build src/index.ts --outdir dist --target node --format esm --external '@dicebear/core'",
    "build:types": "tsc -p tsconfig.build.json",
    "build:json": "cp src/styles/lexavataaars.json dist/lexavataaars.json",
    "prepublishOnly": "bun run build",
    "build:docs": "cp ../../LICENSE ../../README.md ."
  },
  "dependencies": {
    "@dicebear/core": "^10.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
